# --- Egress Policy: Webex API for K-Guard App ---
kind: NetworkPolicy
apiVersion: networking.k8s.io/v1
metadata:
  name: sentinel-webex-egress
  namespace: k-guard
  labels:
    managed-by: k-guard-sentinel
spec:
  podSelector:
    matchLabels:
      app: k-guard
  policyTypes: ["Egress"]
  egress:
    - to:
      - ipBlock: { cidr: 0.0.0.0/0 } # Webex API endpoint
      ports:
        - protocol: TCP
          port: 443