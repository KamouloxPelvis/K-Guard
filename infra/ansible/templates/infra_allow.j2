# --- Infrastructure Layer: Common Services ---
# Allows critical communication: DNS, API Server, and Monitoring
kind: NetworkPolicy
apiVersion: networking.k8s.io/v1
metadata:
  name: sentinel-infra-allow
  namespace: {{ ns_item }}
  labels:
    managed-by: k-guard-sentinel
spec:
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress
  egress:
    # Allow DNS
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53

    # Allow Kubernetes API
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0
      ports:
        - protocol: TCP
          port: 6443

  ingress:
{% if monitoring_enabled %}
    # Allow monitoring probes
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: monitoring
      ports:
        - protocol: TCP
          port: 9090
        - protocol: TCP
          port: 8080
{% endif %}
